# MongoDB Atlas se mila connection string yahan paste karo
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/inhouse-gym

# Admin secret — yehi value frontend (main.jsx) me ADMIN_KEY me bhi rakho
ADMIN_KEY=change-this-admin-key

# Render khud PORT set karta hai, local me 5000 chalega
PORT=5000
